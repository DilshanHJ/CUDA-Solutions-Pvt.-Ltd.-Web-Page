+.about-culture-layout { display: grid; grid-template-columns: .9fr 1.1fr; gap: 56px; align-items: start; }
+.about-culture-photo { border-radius: 24px; overflow: hidden; background: #dce5e5; }
+.about-culture-photo img { display: block; width: 100%; aspect-ratio: 1.1; object-fit: cover; }
+.about-culture-list details { border-bottom: 1px solid #ccd9dc; }
+.about-culture-list summary { list-style: none; display: flex; align-items: center; gap: 16px; cursor: pointer; padding: 24px 0; }
+.about-culture-list summary::-webkit-details-marker { display: none; }
+.about-culture-list summary > span:first-child { color: #457b9d; font-size: .75rem; }
+.about-culture-list h3 { font-size: 1.3rem; margin: 0; flex: 1; }
+.culture-toggle { font-size: 1.5rem; transition: transform .2s; }
+.about-culture-list [open] .culture-toggle { transform: rotate(45deg); }
+.about-culture-list p { padding: 0 32px 24px; margin: 0; color: #526774; }
+
+.services-intro { display: grid; grid-template-columns: 1.1fr .9fr; gap: 64px; align-items: end; padding-bottom: 64px; }
+.services-intro-copy .editorial-lead { margin-top: 20px; }
+.services-capabilities { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #ffffff26; }
+.services-capabilities a { display: flex; gap: 16px; align-items: center; padding: 28px 20px; border-right: 1px solid #ffffff26; transition: background .2s; }
+.services-capabilities a:first-child { padding-left: 0; }
+.services-capabilities a:last-child { border-right: 0; }
+.services-capabilities a:hover { background: #a8dadc0c; }
+.services-capabilities span { color: #a8dadc; font-size: .7rem; }
+.services-capabilities strong { flex: 1; font-size: .85rem; font-weight: 500; }
+.services-detail-copy { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding-bottom: 40px; margin-bottom: 40px; border-bottom: 1px solid #dce5e5; }
+.services-detail-copy p { color: #526774; margin: 0; }
+.services-offerings { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
+.services-offerings .editorial-surface { display: flex; flex-direction: column; padding: 28px; }
+.services-offerings h3 { margin-bottom: 20px; }
+.services-offerings p { color: #526774; font-size: .95rem; }
+.services-offerings ul { display: grid; gap: 12px; padding: 28px 0; margin-bottom: auto; list-style: none; }
+.services-offerings li { display: flex; gap: 8px; align-items: center; font-size: .83rem; }
+.services-offerings li svg { flex-shrink: 0; color: #457b9d; }
+.services-offerings .editorial-text-link { padding-bottom: 0; }
+.services-tech-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
+.services-tech-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
+.services-tech-grid span { display: grid; place-items: center; border: 1px solid #ffffff26; background: #ffffff05; border-radius: 12px; min-height: 64px; color: #d8e8e9; font-size: .8rem; }
+
+.products-intro { display: grid; grid-template-columns: 1.2fr .8fr; gap: 64px; align-items: end; }
+.products-intro .editorial-lead { margin: 0; }
+.products-index { display: flex; margin-top: 56px; border-top: 1px solid #ffffff26; }
+.products-index a { display: flex; align-items: center; gap: 20px; padding: 28px 40px 28px 0; font-size: .9rem; }
+.products-index span { color: #a8dadc; font-size: .75rem; }
+.products-showcase { display: grid; gap: 32px; }
+.product-editorial-card { display: grid; grid-template-columns: 1fr 1fr; padding: 0; }
+.product-identity { padding: 40px; display: flex; flex-direction: column; justify-content: space-between; background: linear-gradient(140deg, #06111d, #153a52); color: #fff; }
+.products-showcase > div:nth-child(even) .product-identity { background: linear-gradient(140deg, #0a2034, #24555d); }
+.product-identity .editorial-card-top { color: #a8dadc; }
+.product-identity h3 { font-size: clamp(2.3rem, 3.6vw, 3.6rem); margin: 12px 0; letter-spacing: -.06em; }
+.product-identity .product-subtitle { color: #bed3d7; }
+.product-signals { display: grid; gap: 12px; padding-top: 32px; margin-top: 32px; border-top: 1px solid #ffffff26; }
+.product-signals span { display: flex; gap: 10px; font-size: .8rem; color: #cce0e0; }
+.product-signals svg { flex-shrink: 0; }
+.product-content { padding: 40px; display: flex; flex-direction: column; align-items: start; }
+.product-content p { color: #526774; margin: 0; }
+.product-content ul { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 12px; padding: 32px 0; margin: 0 0 20px; list-style: none; }
+.product-content li { display: flex; gap: 8px; align-items: center; font-size: .86rem; }
+.product-content li svg { color: #457b9d; flex-shrink: 0; }
+.product-content .home-v2-button { margin-top: auto; }
+
+@media (max-width: 1000px) {
+  .home-v2-story-list { grid-template-columns: 1fr; }
+  .home-v2-story-card { display: grid; grid-template-columns: 1fr 240px; gap: 0 32px; }
+  .home-v2-story-top { grid-column: 1 / -1; }
+  .home-v2-story-author { align-self: center; margin: 0; }
+  .editorial-about-hero, .services-intro, .products-intro { gap: 40px; grid-template-columns: 1fr; }
+  .about-origin { border-left: 0; padding: 24px 0 0; border-top: 1px solid #ffffff26; }
+  .about-origin-lines { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
+  .about-origin > strong { font-size: 6rem; }
+  .services-offerings { grid-template-columns: 1fr; }
+  .services-offerings .editorial-surface { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; }
+  .services-offerings .editorial-card-top, .services-offerings .editorial-text-link { grid-column: 1 / -1; }
+  .services-offerings p { grid-column: 1; }
+  .services-offerings ul { grid-column: 2; grid-row: 2 / 4; padding-top: 0; }
+  .services-tech-layout, .about-story-layout, .about-culture-layout { gap: 32px; }
+  .services-tech-grid { grid-template-columns: 1fr 1fr; }
+  .about-values { grid-template-columns: 1fr 1fr; }
+  .product-identity, .product-content { padding: 28px; }
+  .product-content ul { grid-template-columns: 1fr; gap: 12px; }
+}
+@media (max-width: 720px) {
+  .home-v2-stories-heading, .editorial-heading { grid-template-columns: 1fr; gap: 24px; }
+  .home-v2-stories-heading p { max-width: none; }
+  .home-v2-story-card { display: flex; }
+  .home-v2-story-author { align-self: stretch; }
+  .editorial-page h1 { font-size: clamp(2.7rem, 10vw, 4.5rem); }
+  .editorial-about-hero { padding-bottom: 40px; }
+  .about-origin-lines { grid-template-columns: 1fr; gap: 0; }
+  .about-proof { grid-template-columns: 1fr 1fr; gap: 24px 0; }
+  .about-proof > div { padding: 0 16px; }
+  .about-proof > div:nth-child(odd) { padding-left: 0; }
+  .about-proof > div:nth-child(even) { border-right: 0; }
+  .about-proof span { font-size: .75rem; }
+  .about-story-layout, .about-culture-layout, .about-purpose, .services-detail-copy, .services-tech-layout, .product-editorial-card { grid-template-columns: 1fr; }
+  .about-story-photo { min-height: 400px; }
+  .about-purpose .editorial-surface { padding: 28px; }
+  .about-values { gap: 32px 24px; }
+  .services-capabilities { grid-template-columns: 1fr; }
+  .services-capabilities a { border-right: 0; border-bottom: 1px solid #ffffff26; padding-inline: 0; }
+  .services-offerings .editorial-surface { display: flex; }
+  .services-offerings ul { padding-top: 24px; }
+  .products-index { flex-direction: column; }
+  .products-index a { padding-right: 0; justify-content: space-between; }
+  .products-index a + a { border-top: 1px solid #ffffff26; }
+  .product-content ul { grid-template-columns: 1fr 1fr; }
+}
+@media (max-width: 400px) {
+  .about-values, .product-content ul { grid-template-columns: 1fr; }
+  .editorial-actions { display: grid; }
+  .product-content, .product-identity { padding: 24px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto !important; }
+  .editorial-page *, .editorial-page *::before, .home-v2-stories *, .site-nav * { animation: none !important; transition: none !important; }
+}
