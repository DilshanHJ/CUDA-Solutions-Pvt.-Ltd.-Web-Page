+/* Interactive enterprise service cards */
+.service-interactive-card {
+  --mouse-x: 50%;
+  --mouse-y: 50%;
+  isolation: isolate;
+  box-shadow: 0 18px 45px rgba(4, 18, 31, 0.16);
+  transition: border-color 260ms ease, background-color 260ms ease,
+    box-shadow 260ms ease;
+}
+
+.service-interactive-card:hover {
+  border-color: rgba(168, 218, 220, 0.34);
+  background: rgba(255, 255, 255, 0.075);
+  box-shadow: 0 28px 65px rgba(4, 18, 31, 0.28);
+}
+
+.service-card-pointer-glow {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  opacity: 0;
+  background: radial-gradient(
+    380px circle at var(--mouse-x) var(--mouse-y),
+    rgba(168, 218, 220, 0.14),
+    rgba(69, 123, 157, 0.06) 30%,
+    transparent 62%
+  );
+  transition: opacity 240ms ease;
+  z-index: 0;
+}
+
+.service-interactive-card:hover .service-card-pointer-glow {
+  opacity: 1;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .service-interactive-card,
+  .service-card-pointer-glow {
+    transition: none !important;
+  }
+}
