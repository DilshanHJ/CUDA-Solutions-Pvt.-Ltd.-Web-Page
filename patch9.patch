+  background-size: 62px 62px;
+  mask-image: linear-gradient(to bottom, black 0%, transparent 90%);
+}
+.home-v2-grid--fade { opacity: 0.72; mask-image: linear-gradient(to bottom, transparent, black 16%, black 74%, transparent); }
+.home-v2-orb { position: absolute; border-radius: 999px; pointer-events: none; filter: blur(1px); }
+.home-v2-orb-a { width: 760px; height: 760px; right: -330px; top: -310px; background: radial-gradient(circle, rgba(69,123,157,.22), transparent 67%); }
+.home-v2-orb-b { width: 500px; height: 500px; left: 22%; bottom: -340px; background: radial-gradient(circle, rgba(230,57,70,.12), transparent 67%); }
