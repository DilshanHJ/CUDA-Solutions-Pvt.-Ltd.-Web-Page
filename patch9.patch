+  letter-spacing: .12em;
+  text-transform: uppercase;
+}
+.home-v2-eyebrow > span:not(.home-v2-live-dot) { color: rgba(29,53,87,.38); font-variant-numeric: tabular-nums; }
+.home-v2-eyebrow--dark { color: rgba(241,250,238,.7); }
+.home-v2-eyebrow--dark > span:not(.home-v2-live-dot) { color: rgba(168,218,220,.55); }
