+.workforce-phone-profile small { margin-top:0.1rem; color:#71717a; font-size:0.4rem; }
+.clock-card { margin-top:0.8rem; padding:0.8rem; border-radius:14px; color:#fff; background:linear-gradient(145deg,#1d3557,#244a64); text-align:center; }
+.clock-card svg { color:#fca5a5; margin:0 auto 0.45rem; }
+.clock-card span,.clock-card strong { display:block; }
+.clock-card span { color:rgba(241,250,238,0.62); font-size:0.42rem; }
+.clock-card strong { margin:0.18rem 0 0.55rem; font:700 1.05rem/1 "Space Grotesk",sans-serif; }
+.clock-button { display:block; width:100%; padding:0.42rem; border-radius:8px; color:#fff; background:#e63946; font-size:0.46rem; font-weight:800; }
+.phone-quick-actions { display:grid; grid-template-columns:repeat(3,1fr); gap:0.3rem; margin-top:0.6rem; }
+.phone-quick-actions span { display:flex; min-width:0; flex-direction:column; align-items:center; gap:0.25rem; padding:0.45rem 0.2rem; border-radius:8px; color:#71717a; background:#f4f4f5; font-size:0.38rem; text-align:center; }
+.phone-quick-actions svg { color:#457b9d; }
+
+.workforce-flow { position:relative; display:grid; grid-template-columns:repeat(5,1fr); gap:0.8rem; }
+.workforce-flow-step { position:relative; min-height:235px; padding:1.25rem; border:1px solid rgba(255,255,255,0.1); border-radius:1.2rem; background:rgba(255,255,255,0.055); }
+.flow-index { color:rgba(241,250,238,0.28); font:700 0.64rem/1 "Space Grotesk",sans-serif; letter-spacing:0.12em; }
+.flow-icon { width:42px; height:42px; display:grid; place-items:center; margin:2rem 0 1rem; border-radius:12px; color:#fca5a5; border:1px solid rgba(230,57,70,0.25); background:rgba(230,57,70,0.1); }
+.workforce-flow-step h3 { margin:0 0 0.5rem; color:#fff; font-size:1rem; }
+.workforce-flow-step p { margin:0; color:rgba(241,250,238,0.58); font-size:0.72rem; line-height:1.6; }
+.flow-arrow { position:absolute; right:-0.95rem; top:50%; z-index:2; color:rgba(168,218,220,0.5); transform:translateY(-50%); }
+
+.ess-showcase { position:relative; min-height:570px; }
+.ess-phone { position:absolute; width:245px; min-height:485px; padding:1.4rem 1.1rem; border-radius:34px; border:8px solid #152a42; background:#fff; box-shadow:0 28px 70px rgba(29,53,87,0.18); }
+.ess-phone-back { left:8%; top:28px; transform:rotate(-7deg); background:#f7f7f8; }
+.ess-phone-front { right:10%; top:0; transform:rotate(5deg); }
+.ess-title { display:block; color:#1d3557; font-size:0.68rem; font-weight:800; }
+.ess-chart { height:150px; display:flex; align-items:flex-end; gap:0.4rem; margin:1.2rem 0; padding:1rem; border-radius:16px; background:#fff; }
+.ess-chart i { flex:1; border-radius:5px 5px 2px 2px; background:linear-gradient(to top,#457b9d,#a8dadc); }
+.ess-list { display:grid; gap:0.45rem; }
+.ess-list span { display:flex; justify-content:space-between; padding:0.6rem; border-radius:9px; color:#71717a; background:#fff; font-size:0.5rem; }
+.ess-list strong { color:#1d3557; }
+.ess-avatar { width:50px; height:50px; display:grid; place-items:center; margin:1.3rem auto 0.9rem; border-radius:50%; color:#fff; background:linear-gradient(135deg,#e63946,#457b9d); font-size:0.7rem; font-weight:800; }
+.ess-greeting,.ess-sub { display:block; text-align:center; }
+.ess-greeting { color:#1d3557; font:700 1rem/1.3 "Space Grotesk",sans-serif; }
+.ess-sub { margin-top:0.35rem; color:#71717a; font-size:0.54rem; }
+.ess-balance { margin-top:1.3rem; padding:1rem; border-radius:14px; background:#f7f7f8; }
+.ess-balance span,.ess-balance strong { display:block; }
+.ess-balance span { color:#71717a; font-size:0.5rem; }
+.ess-balance strong { margin:0.25rem 0 0.65rem; color:#1d3557; font-size:0.85rem; }
+.ess-balance i { display:block; height:6px; border-radius:999px; background:#e4e4e7; overflow:hidden; }
+.ess-balance b { display:block; height:100%; border-radius:999px; background:linear-gradient(90deg,#e63946,#fca5a5); }
+.ess-actions { display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; margin-top:0.8rem; }
+.ess-actions span { display:flex; align-items:center; justify-content:center; gap:0.3rem; padding:0.7rem 0.35rem; border-radius:10px; color:#1d3557; background:#f7f7f8; font-size:0.45rem; font-weight:700; }
+.ess-actions svg { color:#e63946; }
+.ess-feature { display:flex; align-items:center; gap:0.65rem; min-height:58px; padding:0.85rem 1rem; border-radius:12px; border:1px solid rgba(29,53,87,0.08); background:#fff; color:#1d3557; font-size:0.82rem; font-weight:700; box-shadow:0 8px 22px rgba(29,53,87,0.045); }
+.ess-feature svg { color:#e63946; }
+
+@media (max-width: 1150px) {
+  .product-module-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .hospitality-console-wrap,.workforce-console-wrap { transform: scale(0.94); transform-origin: center; }
+  .workforce-flow { grid-template-columns: repeat(3,1fr); }
+  .flow-arrow { display:none; }
+}
+
+@media (max-width: 1024px) {
+  .product-detail-hero .grid { min-height: auto; }
+  .hospitality-console-wrap,.workforce-console-wrap { transform:none; max-width:760px; margin:0 auto; width:100%; }
+  .product-module-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
+  .deployment-card:nth-child(even),.deployment-card:nth-child(even):hover { transform:none; }
+  .ess-showcase { min-height:540px; max-width:620px; width:100%; margin:0 auto; }
+}
+
+@media (max-width: 768px) {
+  .product-launch-card { min-height:auto; padding:1.7rem; border-radius:1.5rem; }
+  .product-signal { border-right:0; border-bottom:1px solid rgba(29,53,87,0.08); }
+  .product-signal:nth-last-child(-n+2) { border-bottom:0; }
+  .console-body { grid-template-columns:44px minmax(0,1fr); }
+  .console-sidebar { padding-inline:0.3rem; }
+  .console-side-icon { width:30px; height:30px; }
+  .console-metrics,.workforce-metrics { grid-template-columns:1fr 1fr; }
+  .console-panels,.workforce-console-grid { grid-template-columns:1fr; }
+  .hospitality-console-wrap,.workforce-console-wrap { min-height:650px; }
+  .hospitality-mobile-card { right:0; bottom:-8px; }
+  .workforce-console-wrap { padding-right:0; padding-bottom:115px; }
+  .workforce-phone { right:12px; bottom:0; }
+  .product-module-grid { gap:0.75rem; }
+  .deployment-grid { gap:0.75rem; }
+  .workforce-flow { grid-template-columns:1fr 1fr; }
+  .ess-phone { width:225px; }
+  .ess-phone-back { left:3%; }
+  .ess-phone-front { right:3%; }
+}
+
+@media (max-width: 560px) {
+  .product-hero-title { font-size: clamp(2.8rem, 15vw, 4.4rem); }
+  .product-trust-row { display:grid; gap:0.65rem; }
+  .product-signal-strip .grid { grid-template-columns:1fr; }
+  .product-signal,.product-signal:nth-last-child(-n+2) { min-height:auto; border-bottom:1px solid rgba(29,53,87,0.08); }
+  .product-signal:last-child { border-bottom:0; }
+  .hospitality-console,.workforce-console { border-radius:1rem; }
+  .console-topbar { grid-template-columns:1fr auto; }
+  .console-property { display:none; }
+  .console-main { padding:0.65rem; }
+  .console-metrics,.workforce-metrics { gap:0.35rem; }
+  .console-metrics > div,.workforce-metrics > div { padding:0.6rem; }
+  .console-panels { gap:0.35rem; }
+  .activity-row { grid-template-columns:7px 35px 65px minmax(0,1fr); gap:0.25rem; }
+  .hospitality-mobile-card { display:none; }
+  .hospitality-console-wrap { min-height:auto; }
+  .workforce-console-wrap { min-height:auto; padding-bottom:0; }
+  .workforce-phone { display:none; }
+  .workforce-activity-row { grid-template-columns:36px 90px minmax(0,1fr); gap:0.25rem; }
+  .product-module-grid,.deployment-grid,.workforce-flow { grid-template-columns:1fr; }
+  .product-module-card { min-height:220px; }
+  .journey-step { grid-template-columns:38px minmax(0,1fr); gap:0.8rem; padding:1.1rem; }
+  .journey-check { display:none; }
+  .local-product-panel { border-radius:1.4rem; }
+  .ess-showcase { min-height:500px; }
+  .ess-phone { width:205px; min-height:440px; padding:1.1rem 0.8rem; }
+  .ess-phone-back { left:0; transform:rotate(-4deg); }
+  .ess-phone-front { right:0; transform:rotate(4deg); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .product-launch-card,
+  .product-launch-orb,
+  .product-module-card,
+  .product-module-card::after,
+  .journey-step,
+  .deployment-card,
+  .product-ghost-button {
+    transition: none !important;
+  }
+}
